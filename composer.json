{
  "name": "sugarcommerce/totp",
  "version": "1.1.1",
  "description": "TOTP (RFC 6238) and HOTP (RFC 4226) two-factor authentication codes. Zero dependencies, verified against the official RFC test vectors. Works with Google Authenticator, 1Password, Bitwarden and Authy.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/totp",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "totp",
    "hotp",
    "2fa",
    "mfa",
    "two-factor",
    "rfc6238",
    "rfc4226",
    "authenticator",
    "otp",
    "base32"
  ],
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Totp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Totp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "bench": "php -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=64M bench/run.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/totp/issues",
    "source": "https://github.com/sugarcommerce/totp"
  }
}
